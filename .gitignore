# Per-host runtime output - never commit. Anchored to the repo root: an
# unanchored WEF/ would also swallow data/wef/ (Windows matches case-insensitively).
/Logs/
/Results/
/Evidence/
/Baseline/
/WEF/
/Intune/
/GPO/

# MkDocs build output (deployed by CI, never committed)
site/

# Downloaded copy of WELA (fetched by Invoke-WELACheck.ps1 -Download)
WELA*/

# WELA output files if WELA is ever run from the repo root by hand
WELA-*.csv
UsableRules.csv
UnusableRules.csv

*.log
