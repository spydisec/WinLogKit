# Per-host runtime output - never commit. Anchored to the repo root: an
# unanchored WEF/ would also swallow any folder of that name deeper in the tree.
/Logs/
/Results/
/Evidence/
/Baseline/
/WEF/
/Intune/
/GPO/

# MkDocs build output (deployed by CI, never committed)
site/

# A WELA copy unzipped next to the kit for a by-hand cross-check (v1's
# Invoke-WELACheck.ps1 also put it, and its Evidence\ output, here)
WELA*/

# WELA output files if WELA is ever run from the repo root by hand
WELA-*.csv
UsableRules.csv
UnusableRules.csv

*.log
